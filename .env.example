# ===== Application =====
DATABASE_URL=sqlite:///./data/finance.db
APP_NAME=Finance
APP_HOST=0.0.0.0
APP_PORT=8080

# development | production | test
APP_ENV=development
DEBUG=true

# ===== Security =====
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production

# ===== Authentication =====
# Bootstrap admin is created on the FIRST startup ONLY when both vars below
# are set AND no user exists yet. NEVER put a real password in this file -
# export them in the deployment environment instead. Existing (legacy) rows
# are assigned to this bootstrap admin automatically when it is created.
AUTH_BOOTSTRAP_USERNAME=
AUTH_BOOTSTRAP_PASSWORD=
# Session lifetime in days (session cookie is HttpOnly + SameSite=Lax;
# Secure is forced automatically when APP_ENV=production).
AUTH_SESSION_TTL_DAYS=30

# ===== CORS =====
# Comma-separated origins allowed to call the API. NEVER use "*" in production.
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080

# ===== Receipt uploads =====
RECEIPT_UPLOAD_DIR=data/receipts
RECEIPT_MAX_SIZE_MB=5

# ===== AI OCR engine (cloud vision default; Ollama optional rollback) =====
# Provider order: cloud vision (openai/gemini) is the default and only needs
# an API key. Ollama stays available for fully-local/offline setups.
#   openai  -> OPENAI_API_KEY required (default model gpt-4o-mini, vision)
#   gemini  -> GEMINI_API_KEY required (default model gemini-2.5-flash)
#   ollama  -> needs a local Ollama server with a vision model
#   none    -> disable AI, use Tesseract/offline only
# If the selected provider has no API key configured, the cloud engine is
# skipped gracefully and the local chain (tesseract/offline) is used.
RECEIPT_AI_ENABLED=true
RECEIPT_AI_PROVIDER=openai
RECEIPT_AI_FALLBACK_TESSERACT=1
RECEIPT_AI_MAX_IMAGE_WIDTH=1280
RECEIPT_AI_JPEG_QUALITY=80

# --- OpenAI (recommended; vision-capable model required) ---
# OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=60

# --- Gemini (alternative cloud provider) ---
# GEMINI_API_KEY=...
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60

# --- Ollama (optional local rollback) ---
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_VISION_MODEL=moondream:1.8b-v2-q4_K_S
# OLLAMA_TIMEOUT_SECONDS=60
# OLLAMA_NUM_CTX=2048
OLLAMA_MAX_IMAGE_BYTES=2097152
