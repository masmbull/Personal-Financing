# ===== Application =====
DATABASE_URL=sqlite:///./data/finance.db
APP_NAME=Finance
APP_HOST=0.0.0.0
APP_PORT=8080

# development | production | test
APP_ENV=development
DEBUG=true

# ===== Security =====
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production

# ===== Authentication =====
# Bootstrap admin is created on the FIRST startup ONLY when both vars below
# are set AND no user exists yet. NEVER put a real password in this file -
# export them in the deployment environment instead. Existing (legacy) rows
# are assigned to this bootstrap admin automatically when it is created.
AUTH_BOOTSTRAP_USERNAME=
AUTH_BOOTSTRAP_PASSWORD=
# Session lifetime in days (session cookie is HttpOnly + SameSite=Lax;
# Secure is forced automatically when APP_ENV=production).
AUTH_SESSION_TTL_DAYS=30

# ===== CORS =====
# Comma-separated origins allowed to call the API. NEVER use "*" in production.
CORS_ORIGINS=http://localhost:8080,http://localhost:3000,http://127.0.0.1:8080

# ===== Receipt uploads =====
RECEIPT_UPLOAD_DIR=data/receipts
RECEIPT_MAX_SIZE_MB=5

# ===== AI OCR engine (Ollama, optional) =====
# Preferred over Tesseract when Ollama is reachable & has the vision model.
# Production low-RAM default:  ollama pull moondream:1.8b-v2-q4_K_S
RECEIPT_AI_ENABLED=true
RECEIPT_AI_PROVIDER=ollama
RECEIPT_AI_FALLBACK_TESSERACT=1
RECEIPT_AI_MAX_IMAGE_WIDTH=1280
RECEIPT_AI_JPEG_QUALITY=80
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=moondream:1.8b-v2-q4_K_S
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_NUM_CTX=2048
OLLAMA_MAX_IMAGE_BYTES=2097152
